# Wzór konfiguracji. Skopiuj do .env.local i uzupełnij dopiero przy podłączaniu kont (docs/ETAP-4-SERWER.md).
# Obecna wersja aplikacji nie czyta jeszcze żadnej z tych wartości.
# Prawdziwych kluczy nie wpisuj do tego pliku: trafia on do repozytorium.

# Publiczne: widoczne w przeglądarce, bezpieczne tylko razem z regułami RLS na każdej tabeli.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tajne: wyłącznie na serwerze. Nigdy z prefiksem NEXT_PUBLIC_ i nigdy w kodzie przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=
